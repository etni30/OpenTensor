{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Open Tensor - Generate Data",
            "type": "debugpy",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "program": "${workspaceFolder}\\main.py",
            "console": "integratedTerminal",
            "args": [
                "--mode",
                "generate_data",
                "--config",
                "./config/cpu_conf.yaml"
            ]        
        },
        {
            "name": "Open Tensor - Train",
            "type": "debugpy",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "program": "${workspaceFolder}\\main.py",
            "console": "integratedTerminal",
            "args": [
                "--mode",
                "train",
                "--config",
                "./config/cpu_conf.yaml"
            ]
        },
        {
            "name": "Open Tensor - Inference",
            "type": "debugpy",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "program": "${workspaceFolder}\\main.py",
            "console": "integratedTerminal",
            "args": [
                "--mode",
                "infer",
                "--config",
                "./config/cpu_conf.yaml"
            ]
        }
    ]
}